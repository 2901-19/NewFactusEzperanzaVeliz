{
    "name": "factus-launcher",
    "productName": "FACTUS",
    "version": "1.0.0",
    "description": "Lanzador de escritorio para el sistema POS FACTUS",
    "author": "FACTUS",
    "private": true,
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist:win": "electron-builder --win nsis"
    },
    "build": {
        "appId": "com.factus.pos",
        "productName": "FACTUS",
        "files": [
            "main.js",
            "config.json",
            "build/icon.ico",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "app-bundle",
                "to": "app",
                "filter": [
                    "**/*",
                    ".env",
                    ".gitignore"
                ]
            },
            {
                "from": "php-bundle",
                "to": "php",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "FACTUS",
            "artifactName": "FACTUS-Setup-${version}.exe"
        },
        "directories": {
            "output": "dist"
        }
    },
    "devDependencies": {
        "electron": "^43.4.0",
        "electron-builder": "^26.15.3"
    }
}
